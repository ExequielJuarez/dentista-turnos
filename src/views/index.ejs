<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">
  <meta name="theme-color" content="#f4fbfa">
  <meta name="description" content="Consultorio odontológico: limpieza, blanqueamiento, ortodoncia y urgencias. Reservá tu turno online.">
  <title>Dental Lumina · Odontología</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <header class="nav">
    <a class="logo" href="#top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.5 2C4.5 2 3 4.3 3 6.8c0 2 .6 3.4 1.2 5.2.5 1.6.6 3.5 1 5.4.3 1.6 1 4.6 2.5 4.6 1.3 0 1.4-2.3 1.9-4 .3-1 .8-1.7 1.4-1.7s1.1.7 1.4 1.7c.5 1.7.6 4 1.9 4 1.5 0 2.2-3 2.5-4.6.4-1.9.5-3.8 1-5.4.6-1.8 1.2-3.2 1.2-5.2C21 4.3 19.500 2 16.500 2c-1.800 0-2.900.9-4.500.9S9.300 2 7.500 2Z"/></svg>Dental Lumina</a>
    <a class="pill" href="#turno">Pedir turno</a>
  </header>

  <main id="top">
    <section class="hero"><div class="wrap">
      <div>
        <span class="tag">● Turnos disponibles esta semana</span>
        <h1>Tu sonrisa, <em>en buenas manos.</em></h1>
        <p>Odontología sin miedo y sin vueltas. Reservá online, recibí la confirmación por WhatsApp y llegá sin esperas.</p>
        <div class="hero-actions">
          <a class="pill" href="#turno">Reservar turno</a>
          <a class="pill soft" href="#servicios">Ver tratamientos</a>
        </div>
        <div class="stats">
          <div><strong>+4.000</strong><span>pacientes atendidos</span></div>
          <div><strong>4.9 ★</strong><span>valoración promedio</span></div>
          <div><strong>15 años</strong><span>de experiencia</span></div>
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <div class="blob b2"></div><div class="blob"></div>
        <svg class="tooth" viewBox="0 0 24 24"><path d="M7.5 2C4.5 2 3 4.3 3 6.8c0 2 .6 3.4 1.2 5.2.5 1.6.6 3.5 1 5.4.3 1.6 1 4.6 2.5 4.6 1.3 0 1.4-2.3 1.9-4 .3-1 .8-1.7 1.4-1.7s1.1.7 1.4 1.7c.5 1.7.6 4 1.9 4 1.5 0 2.2-3 2.5-4.6.4-1.9.5-3.8 1-5.4.6-1.8 1.2-3.2 1.2-5.2C21 4.3 19.5 2 16.5 2c-1.8 0-2.9.9-4.5.9S9.3 2 7.5 2Z"/></svg>
        <svg class="spark s1" viewBox="0 0 24 24"><path d="M12 0l2.5 9.500L24 12l-9.500 2.500L12 24l-2.500-9.500L0 12l9.500-2.500z"/></svg>
        <svg class="spark s2" viewBox="0 0 24 24"><path d="M12 0l2.5 9.500L24 12l-9.500 2.500L12 24l-2.500-9.500L0 12l9.500-2.500z"/></svg>
      </div>
    </div></section>

    <section id="servicios"><div class="wrap">
      <h2 class="sec-h reveal">Tratamientos para <em>cada sonrisa</em></h2>
      <p class="sec-p reveal">Precios de referencia. En la primera consulta armamos un presupuesto a tu medida.</p>
      <%- include('partials/servicios', { servicios }) %>
      <div class="why reveal">
        <div><b>Sin dolor</b><span>Anestesia moderna y trato tranquilo.</span></div>
        <div><b>Puntualidad</b><span>Tu turno es tu turno.</span></div>
        <div><b>Financiación</b><span>Cuotas y obras sociales, consultanos.</span></div>
      </div>
    </div></section>

    <section id="turno" class="book"><div class="wrap">
      <div class="card reveal">
        <div class="head">
          <h2 class="sec-h">Reservá tu <em>turno</em></h2>
          <p><span data-cfg="address"></span> · <span data-cfg="hoursText"></span></p>
        </div>
        <div id="booking"></div>
      </div>
    </div></section>
  </main>

  <footer>© Dental Lumina · Todos los derechos reservados</footer>

  <a class="wa-float" data-wa="Hola! Quiero consultar por un turno odontológico" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.4 15.1L2 22l5-1.6A9.9 9.9 0 1 0 12.04 2Zm5.8 14c-.25.7-1.4 1.3-1.95 1.35-.5.05-1.1.2-3.7-.8-3.1-1.2-5.1-4.4-5.25-4.6-.15-.2-1.25-1.65-1.25-3.15s.8-2.25 1.1-2.55c.3-.3.6-.35.8-.35h.55c.18 0 .42-.07.65.5.25.6.85 2.1.92 2.25.08.15.12.33.02.52-.1.2-.15.32-.3.5-.15.17-.3.38-.45.5-.15.15-.3.3-.13.6.18.3.78 1.28 1.68 2.07 1.15 1.02 2.12 1.35 2.42 1.5.3.15.48.12.65-.07.18-.2.75-.87.95-1.17.2-.3.4-.25.68-.15.27.1 1.75.83 2.05.98.3.15.5.22.57.35.08.12.08.72-.17 1.4Z"/></svg>
  </a>
  <script type="module" src="/js/landing.js"></script>
</body>
</html>
